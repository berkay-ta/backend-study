# Copy to .env and adjust. The app reads this once at boot via internal/config.

# HTTP server
APP_PORT=8080
APP_ENV=local
LOG_LEVEL=info

# MySQL credentials, read by compose. Root is admin-only; the app and
# migrations connect as the limited MYSQL_USER (rights on `league` only).
# Defaults are fine locally; set strong values in the VPS .env.
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=league_api
MYSQL_PASSWORD=league_api

# MySQL DSN for `make run` (host process). Quoted so it can be sourced as env.
MYSQL_DSN='league_api:league_api@tcp(127.0.0.1:3306)/league?parseTime=true&charset=utf8mb4&loc=UTC'
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=5
MYSQL_CONN_MAX_LIFETIME=5m

# Per-IP request rate limit (token bucket, simple in-memory)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Optional static API key. If set, required on write endpoints (X-API-Key header).
API_KEY=

# OpenAI — optional. Without OPENAI_API_KEY, AI predictor returns 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=20s

# Monte Carlo predictor
MONTECARLO_SIMULATIONS=10000

# Graceful shutdown drain timeout
SHUTDOWN_TIMEOUT=15s

# Static frontend directory. Served at "/" when present. Set to "" to disable.
WEB_DIR=./web
